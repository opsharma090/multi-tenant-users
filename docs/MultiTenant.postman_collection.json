{
  "info": {
    "name": "Multi-Tenant User Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local assignment API. Run Login first. Token values are saved as collection variables. Mutating requests create real development data."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "admin@alpha.com"
    },
    {
      "key": "password",
      "value": "Admin@123"
    },
    {
      "key": "tenant_code",
      "value": "alpha"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    },
    {
      "key": "org_code",
      "value": "postman-org"
    },
    {
      "key": "invitation_email",
      "value": ""
    },
    {
      "key": "invitation_password",
      "value": ""
    },
    {
      "key": "invitation_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "description": "Public database readiness",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "description": "Authenticate in one active tenant",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_code\": \"{{tenant_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"access_token\", data.access_token);",
              "  pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/refresh",
        "description": "Rotate a refresh token; old token returns 401 on reuse",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"access_token\", data.access_token);",
              "  pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Current Identity",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/me",
        "description": "Any active authenticated member"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Permission Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/permission-check",
        "description": "user:create; demonstration endpoint"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/users?page=1&limit=20&search=",
        "description": "user:read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "description": "user:create; new identity only",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"Postman@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"user_id\", String(pm.response.json().data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get User",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/users/{{user_id}}",
        "description": "user:read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update User",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}",
        "description": "user:update; tenant display name only",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Roles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/roles?page=1&limit=20&search=",
        "description": "role:read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles",
        "description": "role:create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"postman-role-{{$timestamp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"role_id\", String(pm.response.json().data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "List Permissions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/permissions",
        "description": "permission:read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Set Role Permissions",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/roles/{{role_id}}/permissions",
        "description": "permission:assign; replaces full list; [] clears it",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"permissions\": [\n    \"user:read\",\n    \"user:create\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign Role",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/users/{{user_id}}/roles/{{role_id}}",
        "description": "role:assign; additive and idempotent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Current Tenant",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/tenant",
        "description": "tenant:read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Current Tenant",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/tenant",
        "description": "tenant:update; both name and status required",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Organization Alpha Updated\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Organization",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/tenants",
        "description": "tenant:create; caller becomes new organization admin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Organization\",\n  \"code\": \"{{org_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Audit Logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/audit-logs?page=1&limit=20",
        "description": "audit:read; optional exact action filter"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/users/{{user_id}}",
        "description": "user:delete; soft-delete membership, revoke its refresh tokens and remove its roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
  "name": "Create Invitation",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"email\": \"{{invitation_email}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    },
    "url": "{{base_url}}/invitations"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Invitation created', function () {",
          "  pm.response.to.have.status(201);",
          "});",
          "if (pm.response.code === 201) {",
          "  pm.collectionVariables.set('invitation_token', pm.response.json().data.invitation_token);",
          "}"
        ]
      }
    }
  ]
},
{
  "name": "Accept Invitation",
  "request": {
    "auth": {
      "type": "noauth"
    },
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"invitation_token\": \"{{invitation_token}}\",\n  \"email\": \"{{invitation_email}}\",\n  \"password\": \"{{invitation_password}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    },
    "url": "{{base_url}}/invitations/accept"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Invitation accepted', function () {",
          "  pm.response.to.have.status(200);",
          "});"
        ]
      }
    }
  ]
}
  ]
}